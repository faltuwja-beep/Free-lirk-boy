name: Telegram Auto Daily Command

on:
  schedule:
    - cron: '30 23 * * *'  # UTC time ke mutabiq (Indian Time subah 5:30 baje ke liye set hai)
  workflow_dispatch: # Isse tu GitHub website se button daba kar manually bhi run kar sakega

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run script
        env:
          TELEGRAM_SESSION: ${{ secrets.TELEGRAM_SESSION }}
        run: |
          python pp.py
